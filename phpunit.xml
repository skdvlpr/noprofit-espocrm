<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    defaultTestSuite="unit"
    failOnRisky="false"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/integration</directory>
            <exclude>tests/integration/Core</exclude>
            <exclude>tests/integration/Support</exclude>
            <exclude>tests/integration/Espo/Support</exclude>
        </testsuite>
    </testsuites>
</phpunit>
