{
    "authMethod": "OAuth2",
    "view": "google-integration:views/admin/integrations/edit",
    "clientClassName": "Espo\\Modules\\GoogleIntegration\\Core\\ExternalAccount\\Clients\\Google",
    "allowUserAccounts": true,
    "userView": "google-integration:views/external-account/oauth2",
    "tokenType": "Bearer",
    "authType": "Form",
    "fields": {
        "clientId": {
            "type": "varchar",
            "maxLength": 255,
            "required": true
        },
        "clientSecret": {
            "type": "password",
            "maxLength": 255,
            "required": true
        },
        "googleCalendarDescriptionTemplateMeeting": {
            "type": "text",
            "default": "{{name}}\n\n{{description}}\n\nEspoCRM: {{espocrmUrl}}"
        },
        "googleCalendarDescriptionTemplateCall": {
            "type": "text",
            "default": "{{name}}\n\n{{description}}\n\nEspoCRM: {{espocrmUrl}}"
        },
        "googleCalendarDescriptionTemplateTask": {
            "type": "text",
            "default": "{{name}}\nPriority: {{priority}}\nStatus: {{status}}\n\n{{description}}\n\nEspoCRM: {{espocrmUrl}}"
        },
        "googleCalendarDescriptionTemplateOpportunity": {
            "type": "text",
            "default": "Grants & Funding: {{name}}\nAccount: {{account.name}}\nAmount: {{amount}}\nPresentation date: {{presentationDate}}\nClose date: {{closeDate}}\n\n{{description}}\n\nEspoCRM: {{espocrmUrl}}"
        },
        "googleCalendarDescriptionTemplateVolunteerEmployee": {
            "type": "text",
            "default": "{{name}}\nStart: {{startDate}}\nEnd: {{endDate}}\n\n{{extra}}\n\nEspoCRM: {{espocrmUrl}}"
        },
        "googleCalendarAutoCreateEnabled": {
            "type": "bool",
            "default": false
        }
    },
    "params": {
        "endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "scope": "openid email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive.file"
    },
    "externalAccountSecretAttributeList": [
        "accessToken",
        "refreshToken"
    ]
}
