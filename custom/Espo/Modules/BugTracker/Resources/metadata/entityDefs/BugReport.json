{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "trim": true,
            "maxLength": 255,
            "readOnly": true,
            "tooltip": true,
            "audited": true
        },
        "description": {
            "type": "text",
            "audited": true
        },
        "status": {
            "type": "enum",
            "options": [
                "New",
                "Open",
                "InProgress",
                "Closed"
            ],
            "default": "New",
            "displayAsLabel": true,
            "style": {
                "New": "danger",
                "Open": "info",
                "InProgress": "warning",
                "Closed": "success"
            },
            "audited": true
        },
        "pageUrl": {
            "type": "url",
            "maxLength": 2000,
            "readOnly": true,
            "audited": true
        },
        "pageTitle": {
            "type": "varchar",
            "maxLength": 255,
            "readOnly": true,
            "audited": true
        },
        "screenshots": {
            "type": "attachmentMultiple",
            "accept": [
                "image/*"
            ],
            "maxCount": 20,
            "previewSize": "medium",
            "tooltip": true,
            "audited": true
        },
        "screenshotsClearedAt": {
            "type": "datetime",
            "readOnly": true,
            "audited": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user",
            "audited": true
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams",
            "audited": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "description",
            "pageUrl",
            "pageTitle"
        ]
    },
    "statusField": "status",
    "indexes": {
        "status": {
            "columns": [
                "status",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt",
                "deleted"
            ]
        }
    }
}
