{
    "color": "#5b9bd4",
    "iconClass": "fas fa-id-badge",
    "recordViews": {
        "detail": "nonprofit-espocrm:views/contact/record/detail",
        "list": "nonprofit-espocrm:views/contact/record/list"
    },
    "styleMap": {
        "contactType": {
            "HelpSeeker": "primary",
            "Colleague": "info",
            "Volunteer": "success",
            "Employee": "warning",
            "MemberContact": "success",
            "AssociationRepresentative": "warning",
            "Other": "default"
        },
        "personnelStatus": {
            "Active": "success",
            "Inactive": "danger"
        },
        "positionsHeld": {
            "President": "danger",
            "VicePresident": "warning",
            "Councilor": "info",
            "Treasurer": "success",
            "Founder": "primary"
        }
    },
    "filterList": [
        "portalUsers",
        {
            "name": "volunteersEmployees"
        },
        {
            "name": "volunteersOccasionali"
        },
        {
            "name": "associati"
        }
    ],
    "menu": {
        "list": {
            "buttons": [
                {
                    "labelTranslation": "Global.labels.reportingEmailExport",
                    "name": "reportingEmailExport",
                    "style": "default",
                    "acl": "read",
                    "handler": "nonprofit-espocrm:handlers/reporting/email-export",
                    "actionFunction": "send"
                }
            ]
        }
    },
    "dynamicLogic": {
        "panels": {
            "personnelVolunteerEmployee": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "personnelMember": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            }
        },
        "fields": {
            "isOccasional": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "Volunteer"
                        }
                    ]
                }
            },
            "startDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "endDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "contractType": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "Employee"
                        }
                    ]
                }
            },
            "weeklyHours": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "monthlyHours": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "extra": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee"]
                        }
                    ]
                }
            },
            "birthPlace": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee", "MemberContact"]
                        }
                    ]
                }
            },
            "birthProvince": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee", "MemberContact"]
                        }
                    ]
                }
            },
            "joinDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            },
            "leaveDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            },
            "positionsHeld": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            },
            "notes": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            },
            "taxCode": {
                "required": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "contactType",
                            "value": "MemberContact"
                        }
                    ]
                }
            },
            "firstName": {
                "required": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "contactType",
                            "value": ["Volunteer", "Employee", "MemberContact"]
                        }
                    ]
                }
            }
        }
    },
    "relationshipPanels": {
        "relatedPayments": {
            "layout": "listSmall",
            "orderBy": "transactionDate",
            "orderDirection": "desc"
        },
        "relatedPaymentsAsBeneficiary": {
            "layout": "listSmall",
            "orderBy": "transactionDate",
            "orderDirection": "desc"
        }
    }
}
