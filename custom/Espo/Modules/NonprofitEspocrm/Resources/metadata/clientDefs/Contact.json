{
    "color": "#5b9bd4",
    "iconClass": "fas fa-id-badge",
    "recordViews": {
        "detail": "nonprofit-espocrm:views/contact/record/detail",
        "edit": "nonprofit-espocrm:views/contact/record/edit",
        "editSmall": "nonprofit-espocrm:views/contact/record/edit-small",
        "editQuick": "nonprofit-espocrm:views/contact/record/edit-small",
        "list": "nonprofit-espocrm:views/contact/record/list"
    },
    "additionalLayouts": {
        "detailConvert": {
            "type": "detail"
        }
    },
    "styleMap": {
        "contactType": {
            "HelpSeeker": "primary",
            "Colleague": "info",
            "Volunteer": "success",
            "Employee": "warning",
            "MemberContact": "success",
            "AssociationRepresentative": "warning",
            "Other": "default"
        },
        "personnelStatus": {
            "Active": "success",
            "Inactive": "danger"
        },
        "positionsHeld": {
            "President": "danger",
            "VicePresident": "warning",
            "Councilor": "info",
            "Treasurer": "success",
            "Founder": "primary"
        }
    },
    "bottomPanels": {
        "detail": [
            {
                "name": "pdfPreview",
                "label": "pdfPreview",
                "view": "nonprofit-espocrm:views/lead/panels/pdf-preview",
                "order": 1
            }
        ],
        "edit": [
            {
                "name": "pdfPreview",
                "label": "pdfPreview",
                "view": "nonprofit-espocrm:views/lead/panels/pdf-preview",
                "order": 1
            }
        ]
    },
    "filterList": [
        "portalUsers",
        {
            "name": "volunteers"
        },
        {
            "name": "volunteersOccasionali"
        },
        {
            "name": "employees"
        },
        {
            "name": "associati"
        }
    ],
    "dynamicLogic": {
        "panels": {
            "personnelVolunteerEmployee": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "personnelMember": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "admissionBoard": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "pdfPreview": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            }
        },
        "fields": {
            "isOccasional": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "Volunteer"}
                    ]
                }
            },
            "startDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "endDate": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "contractType": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "Employee"}
                    ]
                }
            },
            "weeklyHours": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "monthlyHours": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "extra": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "activityCompetences": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"}
                            ]
                        }
                    ]
                }
            },
            "createCrmUser": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"},
                                {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                            ]
                        },
                        {
                            "type": "isEmpty",
                            "attribute": "linkedUserId"
                        }
                    ]
                }
            },
            "birthPlace": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"},
                                {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                            ]
                        }
                    ]
                }
            },
            "birthProvince": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"},
                                {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                            ]
                        }
                    ]
                }
            },
            "joinDate": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "leaveDate": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "positionsHeld": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "notes": {
                "visible": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "taxCode": {
                "required": {
                    "conditionGroup": [
                        {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                    ]
                }
            },
            "firstName": {
                "required": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {"type": "has", "attribute": "contactType", "value": "Volunteer"},
                                {"type": "has", "attribute": "contactType", "value": "Employee"},
                                {"type": "has", "attribute": "contactType", "value": "MemberContact"}
                            ]
                        }
                    ]
                }
            }
        }
    },
    "relationshipPanels": {
        "relatedPayments": {
            "layout": "listSmall",
            "orderBy": "transactionDate",
            "orderDirection": "desc"
        },
        "relatedPaymentsAsBeneficiary": {
            "layout": "listSmall",
            "orderBy": "transactionDate",
            "orderDirection": "desc"
        }
    }
}
