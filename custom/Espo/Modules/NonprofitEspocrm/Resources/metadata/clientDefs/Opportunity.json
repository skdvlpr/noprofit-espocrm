{
    "recordViews": {
        "list": "nonprofit-espocrm:views/record/list-inline-edit",
        "kanban": "nonprofit-espocrm:views/opportunity/record/kanban"
    },
    "color": "#54b874",
    "iconClass": "fas fa-hand-holding-usd",
    "relationshipPanels": {
        "primaNotaEntries": {
            "create": true,
            "select": true,
            "orderBy": "transactionDate",
            "orderDirection": "desc"
        }
    },
    "dynamicLogic": {
        "fields": {
            "fundraisingProgress": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "in",
                            "attribute": "stage",
                            "value": [
                                "Fundraising",
                                "Closed Won",
                                "Closed Lost"
                            ]
                        }
                    ]
                }
            }
        }
    }
}
