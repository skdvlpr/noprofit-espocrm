{
    "controller": "controllers/record",
    "iconClass": "fas fa-calendar-week",
    "color": "#e67e22",
    "recordViews": {
        "detail": "nonprofit-espocrm:views/activity-offer/record/detail",
        "edit": "nonprofit-espocrm:views/activity-offer/record/edit",
        "detailSmall": "nonprofit-espocrm:views/activity-offer/record/detail"
    },
    "quickDetailDisabled": true,
    "quickEditDisabled": true,
    "boolFilterList": [
        "onlyMy"
    ],
    "filterList": [
        {
            "name": "draft"
        },
        {
            "name": "open"
        }
    ],
    "planningPanels": {
        "detail": [
            {
                "name": "coverage",
                "label": "Coverage",
                "view": "nonprofit-espocrm:views/activity-offer/record/panels/coverage",
                "order": 1
            },
            {
                "name": "volunteerStats",
                "label": "VolunteerStats",
                "view": "nonprofit-espocrm:views/activity-offer/record/panels/volunteer-stats",
                "order": 2
            }
        ]
    },
    "bottomPanels": {
        "detail": [
            {
                "name": "slots",
                "label": "Slots",
                "view": "nonprofit-espocrm:views/activity-offer/record/panels/slots",
                "order": 1,
                "create": true,
                "select": false,
                "orderBy": "dateStart",
                "orderDirection": "asc"
            },
            {
                "name": "tasks",
                "label": "PersonalTasks",
                "view": "nonprofit-espocrm:views/activity-offer/record/panels/tasks",
                "order": 2
            }
        ]
    },
    "relationshipPanels": {
        "slots": {
            "create": true,
            "select": false,
            "view": "nonprofit-espocrm:views/activity-offer/record/panels/slots",
            "orderBy": "dateStart",
            "orderDirection": "asc"
        },
        "tasks": {
            "view": "nonprofit-espocrm:views/activity-offer/record/panels/tasks"
        }
    },
    "detailButtonList": [
        {
            "name": "fillAvailability",
            "label": "Fill availability",
            "iconClass": "fas fa-calendar-check",
            "style": "primary",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "fillAvailability",
            "checkVisibilityFunction": "isFillAvailabilityVisible"
        },
        {
            "name": "requestAvailability",
            "label": "Request availability",
            "iconClass": "fas fa-paper-plane",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "requestAvailability",
            "checkVisibilityFunction": "isRequestAvailabilityVisible"
        },
        {
            "name": "requestAvailabilitySelected",
            "label": "Request availability from selected",
            "iconClass": "fas fa-user-check",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "requestAvailabilitySelected",
            "checkVisibilityFunction": "isRequestAvailabilitySelectedVisible"
        },
        {
            "name": "autoAssign",
            "label": "Auto assign",
            "iconClass": "fas fa-magic",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "autoAssign",
            "checkVisibilityFunction": "isAutoAssignVisible"
        },
        {
            "name": "confirmPlan",
            "label": "Confirm plan",
            "iconClass": "fas fa-check-double",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "confirmPlan",
            "checkVisibilityFunction": "isConfirmPlanVisible"
        },
        {
            "name": "sendPendingUpdate",
            "label": "Send update now",
            "iconClass": "fas fa-bell",
            "style": "warning",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "sendPendingUpdate",
            "checkVisibilityFunction": "isSendPendingUpdateVisible"
        },
        {
            "name": "closePlan",
            "label": "Close plan",
            "iconClass": "fas fa-lock",
            "style": "default",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "closePlan",
            "checkVisibilityFunction": "isClosePlanVisible"
        },
        {
            "name": "cancelAll",
            "label": "Cancel all",
            "iconClass": "fas fa-ban",
            "style": "danger",
            "acl": "edit",
            "handler": "nonprofit-espocrm:handlers/activity-offer/shift-actions",
            "actionFunction": "cancelAll",
            "checkVisibilityFunction": "isCancelAllVisible"
        }
    ]
}
