{
    "controller": "controllers/record",
    "color": "#27ae60",
    "iconClass": "fas fa-book",
    "recordViews": {
        "list": "nonprofit-espocrm:views/prima-nota/list"
    },
    "dynamicLogic": {
        "fields": {
            "subjectName": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "subjectPartyId"
                        }
                    ]
                }
            },
            "subjectParty": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isFalse",
                            "attribute": "createSubjectAccount"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createSubjectContact"
                        }
                    ]
                }
            },
            "createSubjectAccount": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isEmpty",
                            "attribute": "subjectPartyId"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createSubjectContact"
                        }
                    ]
                }
            },
            "createSubjectContact": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isEmpty",
                            "attribute": "subjectPartyId"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createSubjectAccount"
                        }
                    ]
                }
            },
            "subjectEmailAddress": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "isTrue",
                                    "attribute": "createSubjectAccount"
                                },
                                {
                                    "type": "isTrue",
                                    "attribute": "createSubjectContact"
                                }
                            ]
                        }
                    ]
                }
            },
            "subjectPhoneNumber": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "isTrue",
                                    "attribute": "createSubjectAccount"
                                },
                                {
                                    "type": "isTrue",
                                    "attribute": "createSubjectContact"
                                }
                            ]
                        }
                    ]
                }
            },
            "beneficiaryName": {
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isNotEmpty",
                            "attribute": "beneficiaryPartyId"
                        }
                    ]
                }
            },
            "description": {
                "required": {
                    "conditionGroup": [
                        {
                            "type": "isEmpty",
                            "attribute": "donationPaymentReference"
                        }
                    ]
                }
            },
            "beneficiaryParty": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isFalse",
                            "attribute": "createBeneficiaryAccount"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createBeneficiaryContact"
                        }
                    ]
                }
            },
            "createBeneficiaryAccount": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isEmpty",
                            "attribute": "beneficiaryPartyId"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createBeneficiaryContact"
                        }
                    ]
                }
            },
            "createBeneficiaryContact": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "isEmpty",
                            "attribute": "beneficiaryPartyId"
                        },
                        {
                            "type": "isFalse",
                            "attribute": "createBeneficiaryAccount"
                        }
                    ]
                }
            },
            "beneficiaryEmailAddress": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "isTrue",
                                    "attribute": "createBeneficiaryAccount"
                                },
                                {
                                    "type": "isTrue",
                                    "attribute": "createBeneficiaryContact"
                                }
                            ]
                        }
                    ]
                }
            },
            "beneficiaryPhoneNumber": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "or",
                            "value": [
                                {
                                    "type": "isTrue",
                                    "attribute": "createBeneficiaryAccount"
                                },
                                {
                                    "type": "isTrue",
                                    "attribute": "createBeneficiaryContact"
                                }
                            ]
                        }
                    ]
                }
            },
            "donationPaymentProvider": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "internalClassification",
                            "value": "Donation"
                        }
                    ]
                },
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "donationPaymentReference": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "internalClassification",
                            "value": "Donation"
                        }
                    ]
                },
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "donationDonorCategory": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "internalClassification",
                            "value": "Donation"
                        }
                    ]
                },
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "id"
                        }
                    ]
                }
            },
            "donationComment": {
                "visible": {
                    "conditionGroup": [
                        {
                            "type": "equals",
                            "attribute": "internalClassification",
                            "value": "Donation"
                        }
                    ]
                },
                "readOnly": {
                    "conditionGroup": [
                        {
                            "type": "isTrue",
                            "attribute": "id"
                        }
                    ]
                }
            }
        }
    },
    "menu": {
        "list": {
            "buttons": [
                {
                    "labelTranslation": "Global.labels.reportingEmailExport",
                    "name": "reportingEmailExport",
                    "style": "default",
                    "acl": "read",
                    "handler": "nonprofit-espocrm:handlers/reporting/email-export",
                    "actionFunction": "send"
                }
            ]
        }
    }
}
