{
    "formatList": [
        "xlsx",
        "csv"
    ],
    "formatDefs": {
        "csv": {
            "processorClassName": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Csv\\TotalsProcessor",
            "params": {
                "fields": {
                    "includeTotals": {
                        "type": "bool",
                        "default": true
                    }
                },
                "layout": [
                    [
                        {"name": "includeTotals"}
                    ]
                ]
            }
        },
        "xlsx": {
            "processorClassName": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Xlsx\\TotalsProcessor",
            "cellValuePreparatorClassNameMap": {
                "bool": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Xlsx\\CellValuePreparators\\Boolean"
            },
            "params": {
                "fields": {
                    "lite": {
                        "type": "bool",
                        "default": false,
                        "tooltip": true
                    },
                    "recordLinks": {
                        "type": "bool",
                        "default": false
                    },
                    "title": {
                        "type": "bool",
                        "default": false,
                        "tooltip": true
                    },
                    "includeTotals": {
                        "type": "bool",
                        "default": true
                    }
                },
                "layout": [
                    [
                        {"name": "lite"},
                        {"name": "recordLinks"},
                        {"name": "title"}
                    ],
                    [
                        {"name": "includeTotals"}
                    ]
                ],
                "dynamicLogic": {
                    "recordLinks": {
                        "visible": {
                            "conditionGroup": [
                                {
                                    "type": "isFalse",
                                    "attribute": "xlsxLite"
                                }
                            ]
                        }
                    },
                    "title": {
                        "visible": {
                            "conditionGroup": [
                                {
                                    "type": "isFalse",
                                    "attribute": "xlsxLite"
                                }
                            ]
                        }
                    }
                }
            }
        },
        "csv-email": {
            "processorClassName": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Csv\\TotalsProcessor",
            "mimeType": "text/csv",
            "fileExtension": "csv",
            "params": {
                "fields": {
                    "includeTotals": {
                        "type": "bool",
                        "default": true
                    },
                    "emailTo": {
                        "type": "varchar",
                        "required": true,
                        "view": "views/email/fields/email-address-varchar"
                    },
                    "emailCc": {
                        "type": "varchar",
                        "view": "views/email/fields/email-address-varchar"
                    },
                    "emailBcc": {
                        "type": "varchar",
                        "view": "views/email/fields/email-address-varchar"
                    }
                },
                "layout": [
                    [
                        {"name": "includeTotals"}
                    ],
                    [
                        {"name": "emailTo"}
                    ],
                    [
                        {"name": "emailCc"}
                    ],
                    [
                        {"name": "emailBcc"}
                    ]
                ]
            }
        },
        "xlsx-email": {
            "processorClassName": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Xlsx\\TotalsProcessor",
            "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "fileExtension": "xlsx",
            "cellValuePreparatorClassNameMap": {
                "bool": "Espo\\Modules\\NonprofitEspocrm\\Tools\\Export\\Xlsx\\CellValuePreparators\\Boolean"
            },
            "params": {
                "fields": {
                    "lite": {
                        "type": "bool",
                        "default": false,
                        "tooltip": true
                    },
                    "recordLinks": {
                        "type": "bool",
                        "default": false
                    },
                    "title": {
                        "type": "bool",
                        "default": false,
                        "tooltip": true
                    },
                    "includeTotals": {
                        "type": "bool",
                        "default": true
                    },
                    "emailTo": {
                        "type": "varchar",
                        "required": true,
                        "view": "views/email/fields/email-address-varchar"
                    },
                    "emailCc": {
                        "type": "varchar",
                        "view": "views/email/fields/email-address-varchar"
                    },
                    "emailBcc": {
                        "type": "varchar",
                        "view": "views/email/fields/email-address-varchar"
                    }
                },
                "layout": [
                    [
                        {"name": "lite"},
                        {"name": "recordLinks"},
                        {"name": "title"}
                    ],
                    [
                        {"name": "includeTotals"}
                    ],
                    [
                        {"name": "emailTo"}
                    ],
                    [
                        {"name": "emailCc"}
                    ],
                    [
                        {"name": "emailBcc"}
                    ]
                ],
                "dynamicLogic": {
                    "recordLinks": {
                        "visible": {
                            "conditionGroup": [
                                {
                                    "type": "isFalse",
                                    "attribute": "xlsx-emailLite"
                                }
                            ]
                        }
                    },
                    "title": {
                        "visible": {
                            "conditionGroup": [
                                {
                                    "type": "isFalse",
                                    "attribute": "xlsx-emailLite"
                                }
                            ]
                        }
                    }
                }
            }
        }
    }
}
