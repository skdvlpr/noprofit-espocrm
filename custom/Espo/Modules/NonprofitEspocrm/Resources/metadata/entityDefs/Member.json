{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "status": {
            "type": "enum",
            "options": [
                "Active",
                "Inactive"
            ],
            "default": "Active",
            "required": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Active": "success",
                "Inactive": "danger"
            }
        },
        "firstName": {
            "type": "varchar",
            "required": true
        },
        "lastName": {
            "type": "varchar",
            "required": true
        },
        "birthPlace": {
            "type": "varchar"
        },
        "birthDate": {
            "type": "date"
        },
        "taxCode": {
            "type": "varchar",
            "maxLength": 16,
            "trim": true,
            "validatorClassNameList": [
                "Espo\\Modules\\NonprofitEspocrm\\Classes\\FieldValidators\\Member\\TaxCode\\ItalianFiscalCode"
            ]
        },
        "address": {
            "type": "address",
            "viewMap": true
        },
        "joinDate": {
            "type": "date"
        },
        "leaveDate": {
            "type": "date"
        },
        "positionsHeld": {
            "type": "multiEnum",
            "options": [
                "President",
                "VicePresident",
                "Councilor",
                "Treasurer",
                "Founder"
            ],
            "displayAsLabel": true,
            "style": {
                "President": "danger",
                "VicePresident": "warning",
                "Councilor": "info",
                "Treasurer": "success",
                "Founder": "primary"
            }
        },
        "notes": {
            "type": "wysiwyg"
        },
        "emailAddress": {
            "type": "email",
            "isPersonalData": true
        },
        "phoneNumber": {
            "type": "phone",
            "typeList": ["Mobile", "Office", "Home", "Other"],
            "defaultType": "Mobile",
            "isPersonalData": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": true,
            "view": "views/fields/assigned-user",
            "tooltip": "Primary email/phone are synced from this user."
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "cases": {
            "type": "hasChildren",
            "entity": "Case",
            "foreign": "parent",
            "audited": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": ["name", "firstName", "lastName", "taxCode", "emailAddress", "addressStreet", "addressCity"]
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "taxCode": {
            "columns": ["taxCode", "deleted"]
        },
        "leaveDateStatus": {
            "columns": ["leaveDate", "status", "deleted"]
        },
        "assignedUser": {
            "type": "unique",
            "columns": ["assignedUserId", "deleted"]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true,
    "statusField": "status"
}
