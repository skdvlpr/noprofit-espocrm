{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "contact": {
            "type": "link",
            "required": true
        },
        "taxCode": {
            "type": "varchar",
            "maxLength": 16,
            "readOnly": true
        },
        "birthPlace": {
            "type": "varchar",
            "maxLength": 255
        },
        "household": {
            "type": "int",
            "min": 1,
            "max": 100
        },
        "phone": {
            "type": "text",
            "readOnly": true
        },
        "address": {
            "type": "address",
            "viewMap": true,
            "readOnly": true
        },
        "notes": {
            "type": "text"
        },
        "entryDates": {
            "type": "array",
            "displayAsList": true,
            "noEmptyString": true,
            "view": "nonprofit-espocrm:views/fields/date-array",
            "default": []
        },
        "exitDates": {
            "type": "array",
            "displayAsList": true,
            "noEmptyString": true,
            "view": "nonprofit-espocrm:views/fields/date-array",
            "default": []
        },
        "entryDatesText": {
            "type": "text",
            "readOnly": true,
            "utility": true
        },
        "exitDatesText": {
            "type": "text",
            "readOnly": true,
            "utility": true
        },
        "addressLine": {
            "type": "text",
            "readOnly": true,
            "utility": true
        },
        "phonePdf": {
            "type": "text",
            "readOnly": true,
            "utility": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact",
            "foreign": "foodParcelRegistrations"
        },
        "entryDateLogs": {
            "type": "hasMany",
            "entity": "FoodParcelDateLog",
            "foreign": "entryRegistration",
            "relationName": "foodParcelEntryDateLogs",
            "layoutRelationshipsDisabled": true
        },
        "exitDateLogs": {
            "type": "hasMany",
            "entity": "FoodParcelDateLog",
            "foreign": "exitRegistration",
            "relationName": "foodParcelExitDateLogs",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "optimisticConcurrencyControl": true,
    "audited": true
}
