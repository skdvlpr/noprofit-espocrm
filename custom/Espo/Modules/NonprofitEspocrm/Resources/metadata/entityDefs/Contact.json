{
    "fields": {
        "lastName": {
            "required": false
        },
        "contactType": {
            "type": "multiEnum",
            "options": [
                "HelpSeeker",
                "Colleague",
                "Volunteer",
                "Employee",
                "MemberContact",
                "AssociationRepresentative",
                "Other"
            ],
            "maxCount": 2,
            "displayAsLabel": true,
            "allowCustomOptions": false,
            "audited": true,
            "style": {
                "HelpSeeker": "primary",
                "Colleague": "info",
                "Volunteer": "success",
                "Employee": "warning",
                "MemberContact": "success",
                "AssociationRepresentative": "warning",
                "Other": "default"
            },
            "validatorClassNameList": [
                "Espo\\Modules\\NonprofitEspocrm\\Classes\\FieldValidators\\Contact\\ContactType\\LegalCombination"
            ]
        },
        "emailAddress": {
            "validatorClassNameList": [
                "__APPEND__",
                "Espo\\Modules\\NonprofitEspocrm\\Classes\\FieldValidators\\Contact\\EmailAddress\\UniqueAmongContacts"
            ]
        },
        "relatedRecord": {
            "type": "link",
            "entity": "Account",
            "audited": true
        },
        "account": {
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "accounts": {
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutFiltersDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "address": {
            "viewMap": true
        },
        "taxCode": {
            "type": "varchar",
            "maxLength": 16,
            "trim": true,
            "isPersonalData": true,
            "sanitizerClassNameList": [
                "Espo\\Classes\\FieldSanitizers\\StringUpperCase"
            ],
            "validatorClassNameList": [
                "Espo\\Modules\\NonprofitEspocrm\\Classes\\FieldValidators\\Contact\\TaxCode\\ItalianFiscalCode"
            ]
        },
        "birthDate": {
            "type": "date",
            "isPersonalData": true
        },
        "isUser": {
            "type": "bool",
            "default": false,
            "readOnly": true,
            "tooltip": true
        },
        "linkedUser": {
            "type": "link",
            "view": "views/fields/user",
            "tooltip": true
        },
        "personnelStatus": {
            "type": "enum",
            "options": ["Active", "Inactive"],
            "default": "Active",
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Active": "success",
                "Inactive": "danger"
            }
        },
        "isOccasional": {
            "type": "bool",
            "default": false,
            "tooltip": true
        },
        "birthProvince": {
            "type": "varchar",
            "maxLength": 8,
            "trim": true,
            "tooltip": true,
            "isPersonalData": true
        },
        "startDate": {
            "type": "date"
        },
        "endDate": {
            "type": "date"
        },
        "contractType": {
            "type": "enum",
            "options": ["", "Permanent", "FixedTerm", "Freelance", "Other"],
            "sanitizerClassNameList": [
                "Espo\\Classes\\FieldSanitizers\\EmptyStringToNull"
            ]
        },
        "weeklyHours": {
            "type": "float"
        },
        "monthlyHours": {
            "type": "float",
            "readOnly": true,
            "tooltip": true
        },
        "extra": {
            "type": "text"
        },
        "activityCompetences": {
            "type": "multiEnum",
            "translation": "ActivityOfferSlot.options.category",
            "options": [
                "MealPreparation",
                "MealDistribution",
                "Administrative",
                "LegalDesk",
                "DigitalDesk",
                "Reception",
                "ListeningDesk",
                "MarketCollection",
                "Cleaning",
                "NightReceptionManagement",
                "ProjectDevelopment",
                "GrantsAndFundingManagement",
                "Fundraising",
                "EventOrganization",
                "Secretariat",
                "ServicesAndSupport",
                "Activities",
                "OnCallAvailability"
            ],
            "tooltip": true
        },
        "createCrmUser": {
            "type": "bool",
            "notStorable": true,
            "default": true,
            "tooltip": true,
            "layoutDetailDisabled": true
        },
        "birthPlace": {
            "type": "varchar",
            "isPersonalData": true
        },
        "joinDate": {
            "type": "date"
        },
        "leaveDate": {
            "type": "date"
        },
        "positionsHeld": {
            "type": "multiEnum",
            "options": [
                "President",
                "VicePresident",
                "Councilor",
                "Treasurer",
                "Founder"
            ],
            "displayAsLabel": true,
            "style": {
                "President": "danger",
                "VicePresident": "warning",
                "Councilor": "info",
                "Treasurer": "success",
                "Founder": "primary"
            }
        },
        "notes": {
            "type": "wysiwyg"
        },
        "admissionForm": {
            "type": "file",
            "accept": [".pdf"],
            "sourceList": []
        },
        "migratedFromEntityType": {
            "type": "varchar",
            "maxLength": 64,
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        },
        "migratedFromEntityId": {
            "type": "varchar",
            "maxLength": 24,
            "readOnly": true,
            "layoutDetailDisabled": true,
            "layoutListDisabled": true,
            "layoutMassUpdateDisabled": true
        }
    },
    "links": {
        "relatedRecord": {
            "type": "belongsTo",
            "entity": "Account"
        },
        "linkedUser": {
            "type": "belongsTo",
            "entity": "User",
            "foreign": "linkedContacts"
        },
        "foodParcelRegistrations": {
            "type": "hasMany",
            "entity": "FoodParcelRegistration",
            "foreign": "contact"
        },
        "relatedPayments": {
            "type": "hasChildren",
            "entity": "PrimaNota",
            "foreign": "subjectParty",
            "audited": true
        },
        "relatedPaymentsAsBeneficiary": {
            "type": "hasChildren",
            "entity": "PrimaNota",
            "foreign": "beneficiaryParty",
            "audited": true
        }
    },
    "indexes": {
        "migratedFrom": {
            "columns": ["migratedFromEntityType", "migratedFromEntityId", "deleted"]
        },
        "linkedUser": {
            "columns": ["linkedUserId", "deleted"]
        }
    }
}
