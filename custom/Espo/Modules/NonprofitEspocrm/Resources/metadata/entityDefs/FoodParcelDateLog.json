{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "logDate": {
            "type": "date",
            "required": true
        },
        "entryRegistration": {
            "type": "link"
        },
        "exitRegistration": {
            "type": "link"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "entryRegistration": {
            "type": "belongsTo",
            "entity": "FoodParcelRegistration",
            "foreign": "entryDateLogs"
        },
        "exitRegistration": {
            "type": "belongsTo",
            "entity": "FoodParcelRegistration",
            "foreign": "exitDateLogs"
        }
    },
    "collection": {
        "orderBy": "logDate",
        "order": "desc"
    },
    "optimisticConcurrencyControl": true
}
