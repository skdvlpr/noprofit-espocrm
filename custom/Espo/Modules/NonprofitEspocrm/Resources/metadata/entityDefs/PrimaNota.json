{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "description": {
            "type": "text",
            "required": true
        },
        "subjectName": {
            "type": "varchar",
            "maxLength": 255
        },
        "subjectParty": {
            "type": "linkParent",
            "entityList": [
                "Account",
                "Contact"
            ],
            "audited": true
        },
        "createSubjectAccount": {
            "type": "bool",
            "default": false
        },
        "createSubjectContact": {
            "type": "bool",
            "default": false
        },
        "entryType": {
            "type": "enum",
            "options": [
                "Income",
                "Expense"
            ],
            "required": true,
            "default": "Income",
            "audited": true,
            "view": "nonprofit-espocrm:views/fields/prima-nota-entry-type"
        },
        "amount": {
            "type": "currency",
            "currency": "EUR",
            "required": true
        },
        "amountIn": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "amountOut": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "internalClassification": {
            "type": "enum",
            "options": [
                "Donation",
                "Grant",
                "OperatingExpense",
                "Personnel",
                "Utilities",
                "Supplies",
                "Other"
            ],
            "isSorted": true
        },
        "modelDClassification": {
            "type": "enum",
            "options": [
                "A",
                "B",
                "C",
                "D",
                "E"
            ],
            "isSorted": false,
            "audited": true
        },
        "financing": {
            "type": "link"
        },
        "transactionDate": {
            "type": "date",
            "required": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "financing": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "primaNotaEntries"
        },
        "subjectParty": {
            "type": "belongsToParent"
        }
    },
    "collection": {
        "orderBy": "transactionDate",
        "order": "desc"
    },
    "indexes": {
        "transactionDate": {
            "columns": ["transactionDate", "deleted"]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true
}
