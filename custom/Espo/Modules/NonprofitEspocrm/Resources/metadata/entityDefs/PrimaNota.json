{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "subjectName": {
            "type": "varchar",
            "maxLength": 255
        },
        "subjectParty": {
            "type": "linkParent",
            "entityList": [
                "Account",
                "Contact"
            ],
            "audited": true
        },
        "createSubjectAccount": {
            "type": "bool",
            "default": false
        },
        "createSubjectContact": {
            "type": "bool",
            "default": false
        },
        "subjectEmailAddress": {
            "type": "varchar",
            "maxLength": 255
        },
        "subjectPhoneNumber": {
            "type": "varchar",
            "maxLength": 64
        },
        "beneficiaryName": {
            "type": "varchar",
            "maxLength": 255
        },
        "beneficiaryParty": {
            "type": "linkParent",
            "entityList": [
                "Account",
                "Contact"
            ],
            "audited": true
        },
        "createBeneficiaryAccount": {
            "type": "bool",
            "default": false
        },
        "createBeneficiaryContact": {
            "type": "bool",
            "default": false
        },
        "beneficiaryEmailAddress": {
            "type": "varchar",
            "maxLength": 255
        },
        "beneficiaryPhoneNumber": {
            "type": "varchar",
            "maxLength": 64
        },
        "entryType": {
            "type": "enum",
            "options": [
                "Income",
                "Expense"
            ],
            "required": true,
            "default": "Income",
            "audited": true,
            "view": "nonprofit-espocrm:views/fields/prima-nota-entry-type"
        },
        "amount": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "amountGross": {
            "type": "currency",
            "currency": "EUR"
        },
        "commissionAmount": {
            "type": "currency",
            "currency": "EUR",
            "default": 0
        },
        "commissionPercent": {
            "type": "float",
            "min": 0,
            "max": 100,
            "default": 0
        },
        "amountIn": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "amountOut": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "internalClassification": {
            "type": "enum",
            "options": [
                "Donation",
                "Grant",
                "OperatingExpense",
                "Personnel",
                "Utilities",
                "Supplies",
                "Other"
            ],
            "isSorted": true
        },
        "donationPaymentProvider": {
            "type": "enum",
            "options": [
                "Stripe",
                "SatispayDirect",
                "GoFundMe",
                "FivePerMille",
                "BankTransfer",
                "Cash",
                "Other"
            ],
            "default": "Other",
            "view": "nonprofit-espocrm:views/fields/donation-payment-provider"
        },
        "donationPaymentReference": {
            "type": "varchar",
            "maxLength": 255
        },
        "donationDonorCategory": {
            "type": "enum",
            "options": [
                "Individual",
                "Organization"
            ]
        },
        "donationFrequency": {
            "type": "enum",
            "options": [
                "OneTime",
                "Recurring"
            ],
            "default": "OneTime"
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Planned",
                "Paid",
                "Cancelled",
                "Problematic"
            ],
            "default": "Planned"
        },
        "donationComment": {
            "type": "text"
        },
        "stripePaymentCreatedAt": {
            "type": "datetime"
        },
        "stripeChargeId": {
            "type": "varchar",
            "maxLength": 255
        },
        "stripeBalanceTransactionId": {
            "type": "varchar",
            "maxLength": 255
        },
        "stripePaymentMethodType": {
            "type": "varchar",
            "maxLength": 64
        },
        "stripeCardBrand": {
            "type": "varchar",
            "maxLength": 64
        },
        "stripeCardLast4": {
            "type": "varchar",
            "maxLength": 4
        },
        "stripeReceiptUrl": {
            "type": "url"
        },
        "stripeReceiptEmail": {
            "type": "email"
        },
        "stripeBillingEmail": {
            "type": "email"
        },
        "stripeBillingPhone": {
            "type": "varchar",
            "maxLength": 64
        },
        "stripeFeeDetailsJson": {
            "type": "text"
        },
        "stripeLivemode": {
            "type": "bool"
        },
        "stripeRadarRiskLevel": {
            "type": "varchar",
            "maxLength": 64
        },
        "stripeStatementDescriptor": {
            "type": "varchar",
            "maxLength": 255
        },
        "stripeCustomerId": {
            "type": "varchar",
            "maxLength": 255
        },
        "stripeSubscriptionId": {
            "type": "varchar",
            "maxLength": 255
        },
        "modelDClassification": {
            "type": "enum",
            "options": [
                "A",
                "B",
                "C",
                "D",
                "E"
            ],
            "isSorted": false,
            "audited": true
        },
        "financing": {
            "type": "link"
        },
        "transactionDate": {
            "type": "date",
            "required": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "financing": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "primaNotaEntries"
        },
        "subjectParty": {
            "type": "belongsToParent"
        },
        "beneficiaryParty": {
            "type": "belongsToParent"
        }
    },
    "collection": {
        "orderBy": "transactionDate",
        "order": "desc"
    },
    "indexes": {
        "transactionDate": {
            "columns": [
                "transactionDate",
                "deleted"
            ]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true
}
