{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "subjectName": {
            "type": "varchar",
            "maxLength": 255
        },
        "subjectParty": {
            "type": "linkParent",
            "entityList": [
                "Account",
                "Contact"
            ],
            "audited": true
        },
        "createSubjectAccount": {
            "type": "bool",
            "default": false
        },
        "createSubjectContact": {
            "type": "bool",
            "default": false
        },
        "subjectEmailAddress": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "subjectPhoneNumber": {
            "type": "varchar",
            "maxLength": 64,
            "audited": true
        },
        "beneficiaryName": {
            "type": "varchar",
            "maxLength": 255
        },
        "beneficiaryParty": {
            "type": "linkParent",
            "entityList": [
                "Account",
                "Contact"
            ],
            "audited": true
        },
        "createBeneficiaryAccount": {
            "type": "bool",
            "default": false
        },
        "createBeneficiaryContact": {
            "type": "bool",
            "default": false
        },
        "beneficiaryEmailAddress": {
            "type": "varchar",
            "maxLength": 255
        },
        "beneficiaryPhoneNumber": {
            "type": "varchar",
            "maxLength": 64
        },
        "entryType": {
            "type": "enum",
            "options": [
                "Income",
                "Expense"
            ],
            "required": true,
            "default": "Income",
            "audited": true,
            "view": "nonprofit-espocrm:views/fields/prima-nota-entry-type"
        },
        "amount": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true,
            "audited": true
        },
        "amountGross": {
            "type": "currency",
            "currency": "EUR",
            "audited": true
        },
        "commissionAmount": {
            "type": "currency",
            "currency": "EUR",
            "default": 0,
            "audited": true
        },
        "commissionPercent": {
            "type": "float",
            "min": 0,
            "max": 100,
            "default": 0,
            "audited": true
        },
        "amountIn": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "amountOut": {
            "type": "currency",
            "currency": "EUR",
            "readOnly": true
        },
        "internalClassification": {
            "type": "enum",
            "options": [
                "Donation",
                "Grant",
                "OperatingExpense",
                "Personnel",
                "Utilities",
                "Supplies",
                "Other"
            ],
            "isSorted": true
        },
        "donationPaymentProvider": {
            "type": "enum",
            "options": [
                "Stripe",
                "SatispayDirect",
                "GoFundMe",
                "FivePerMille",
                "BankTransfer",
                "Cash",
                "Other"
            ],
            "default": "Other",
            "view": "nonprofit-espocrm:views/fields/donation-payment-provider",
            "audited": true
        },
        "donationPaymentReference": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "donationDonorCategory": {
            "type": "enum",
            "options": [
                "Individual",
                "Organization"
            ],
            "audited": true
        },
        "donationFrequency": {
            "type": "enum",
            "options": [
                "OneTime",
                "Recurring"
            ],
            "default": "OneTime",
            "audited": true
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Planned",
                "Inviato",
                "Cancelled",
                "Refunded",
                "Disputed",
                "Problematic"
            ],
            "default": "Inviato",
            "displayAsLabel": true,
            "tooltip": true,
            "style": {
                "Planned": "default",
                "Inviato": "success",
                "Cancelled": "danger",
                "Refunded": "warning",
                "Disputed": "danger",
                "Problematic": "warning"
            },
            "audited": true
        },
        "donationComment": {
            "type": "text"
        },
        "stripePaymentCreatedAt": {
            "type": "datetime",
            "audited": true
        },
        "stripeChargeId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeBalanceTransactionId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripePaymentMethodType": {
            "type": "enum",
            "options": [
                "card",
                "link",
                "bancontact",
                "eps",
                "ideal",
                "sepa_debit",
                "paypal",
                "amazon_pay",
                "satispay",
                "mb_way",
                "klarna",
                "other"
            ],
            "displayAsLabel": true,
            "style": {
                "card": "primary",
                "link": "info",
                "bancontact": "default",
                "eps": "default",
                "ideal": "default",
                "sepa_debit": "default",
                "paypal": "info",
                "amazon_pay": "warning",
                "satispay": "success",
                "mb_way": "default",
                "klarna": "warning",
                "other": "default"
            },
            "audited": true
        },
        "stripeCardBrand": {
            "type": "varchar",
            "maxLength": 64,
            "audited": true
        },
        "stripeCardLast4": {
            "type": "varchar",
            "maxLength": 4,
            "audited": true
        },
        "stripeReceiptUrl": {
            "type": "url",
            "audited": true
        },
        "stripeReceiptEmail": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeBillingEmail": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeBillingPhone": {
            "type": "varchar",
            "maxLength": 64,
            "audited": true
        },
        "stripeFeeDetailsJson": {
            "type": "text"
        },
        "stripeLivemode": {
            "type": "bool",
            "audited": true
        },
        "stripeRadarRiskLevel": {
            "type": "enum",
            "options": [
                "normal",
                "elevated",
                "highest"
            ],
            "displayAsLabel": true,
            "style": {
                "normal": "success",
                "elevated": "warning",
                "highest": "danger"
            },
            "audited": true
        },
        "stripeStatementDescriptor": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeCustomerId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeSubscriptionId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeInvoiceId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripeInvoiceNumber": {
            "type": "varchar",
            "maxLength": 64,
            "audited": true
        },
        "stripePayoutId": {
            "type": "varchar",
            "maxLength": 255,
            "audited": true
        },
        "stripePayoutPaidAt": {
            "type": "datetime",
            "audited": true
        },
        "modelDClassification": {
            "type": "enum",
            "options": [
                "A",
                "B",
                "C",
                "D",
                "E"
            ],
            "isSorted": false,
            "audited": true
        },
        "financing": {
            "type": "link"
        },
        "transactionDate": {
            "type": "date",
            "required": true,
            "audited": true
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "financing": {
            "type": "belongsTo",
            "entity": "Opportunity",
            "foreign": "primaNotaEntries"
        },
        "subjectParty": {
            "type": "belongsToParent",
            "foreign": "relatedPayments"
        },
        "beneficiaryParty": {
            "type": "belongsToParent",
            "foreign": "relatedPaymentsAsBeneficiary"
        }
    },
    "collection": {
        "orderBy": "transactionDate",
        "order": "desc",
        "textFilterFields": [
            "name",
            "donationPaymentReference",
            "stripeChargeId",
            "stripeBalanceTransactionId",
            "subjectName",
            "beneficiaryName",
            "description"
        ]
    },
    "indexes": {
        "transactionDate": {
            "columns": [
                "transactionDate",
                "deleted"
            ]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true
}
