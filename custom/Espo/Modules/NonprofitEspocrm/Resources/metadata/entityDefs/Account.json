{
    "fields": {
        "billingAddress": {
            "viewMap": true
        },
        "shippingAddress": {
            "viewMap": true,
            "view": "nonprofit-espocrm:views/fields/address"
        },
        "sector": {
            "type": "enum",
            "options": [
                "",
                "ThirdSector",
                "SocialWorkers",
                "Public"
            ],
            "style": {
                "ThirdSector": "success",
                "SocialWorkers": "primary",
                "Public": "info"
            },
            "audited": true
        }
    },
    "links": {
        "websites": {
            "type": "hasMany",
            "entity": "AccountWebsite",
            "foreign": "account",
            "audited": true
        },
        "associationMealCounts": {
            "type": "hasMany",
            "entity": "AssociationMealCount",
            "foreign": "account"
        },
        "relatedPayments": {
            "type": "hasChildren",
            "entity": "PrimaNota",
            "foreign": "subjectParty",
            "audited": true
        },
        "relatedPaymentsAsBeneficiary": {
            "type": "hasChildren",
            "entity": "PrimaNota",
            "foreign": "beneficiaryParty",
            "audited": true
        }
    }
}
