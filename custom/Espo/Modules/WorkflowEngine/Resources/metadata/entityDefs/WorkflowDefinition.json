{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "trim": true
        },
        "isActive": {
            "type": "bool",
            "default": true
        },
        "targetEntityType": {
            "type": "varchar",
            "required": true,
            "maxLength": 100
        },
        "triggerType": {
            "type": "enum",
            "required": true,
            "options": ["afterCreate", "afterUpdate"],
            "default": "afterCreate"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "modifiedAt",
        "order": "desc",
        "textFilterFields": ["name", "targetEntityType", "description"]
    },
    "indexes": {
        "workflowDefinitionTargetEntityType": {
            "columns": ["targetEntityType", "deleted"]
        },
        "workflowDefinitionActiveTrigger": {
            "columns": ["isActive", "triggerType", "deleted"]
        }
    }
}
