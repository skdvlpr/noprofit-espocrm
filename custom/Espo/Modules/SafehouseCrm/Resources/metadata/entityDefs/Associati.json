{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "stato": {
            "type": "enum",
            "options": [
                "Attivo",
                "Inattivo"
            ],
            "default": "Attivo",
            "required": true,
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Attivo": "success",
                "Inattivo": "danger"
            }
        },
        "nome": {
            "type": "varchar",
            "required": true
        },
        "cognome": {
            "type": "varchar",
            "required": true
        },
        "luogoNascita": {
            "type": "varchar"
        },
        "dataNascita": {
            "type": "date"
        },
        "cf": {
            "type": "varchar",
            "maxLength": 16,
            "trim": true,
            "validatorClassNameList": [
                "Espo\\Modules\\SafehouseCrm\\Classes\\FieldValidators\\Associati\\Cf\\ItalianFiscalCode"
            ]
        },
        "indirizzoResidenza": {
            "type": "varchar"
        },
        "citta": {
            "type": "varchar"
        },
        "provincia": {
            "type": "varchar",
            "maxLength": 2,
            "trim": true
        },
        "dataIngresso": {
            "type": "date"
        },
        "dataDimissione": {
            "type": "date"
        },
        "incarichiRicoperti": {
            "type": "text"
        },
        "annotazioni": {
            "type": "wysiwyg"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "cf": {
            "columns": ["cf", "deleted"]
        },
        "dataDimissioneStato": {
            "columns": ["dataDimissione", "stato", "deleted"]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true,
    "statusField": "stato"
}
