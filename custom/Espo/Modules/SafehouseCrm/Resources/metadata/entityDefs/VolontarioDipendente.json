{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "tipo": {
            "type": "enum",
            "options": [
                "Volontario",
                "Dipendente"
            ],
            "required": true
        },
        "nome": {
            "type": "varchar",
            "required": true
        },
        "cognome": {
            "type": "varchar",
            "required": true
        },
        "dataNascita": {
            "type": "date"
        },
        "emailAddress": {
            "type": "email",
            "required": true,
            "isPersonalData": true
        },
        "phoneNumber": {
            "type": "phone",
            "typeList": ["Mobile", "Office", "Home", "Other"],
            "defaultType": "Mobile",
            "isPersonalData": true
        },
        "user": {
            "type": "link",
            "required": true,
            "tooltip": "Linked user account. Primary email/phone are synced from this user."
        },
        "dataInizio": {
            "type": "date"
        },
        "dataFine": {
            "type": "date"
        },
        "tipoContratto": {
            "type": "enum",
            "options": [
                "Tempo Indeterminato",
                "Tempo Determinato",
                "Partita IVA",
                "Altro"
            ]
        },
        "oreSettimanali": {
            "type": "float"
        },
        "oreMensili": {
            "type": "float",
            "readOnly": true,
            "tooltip": true
        },
        "extra": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "status": {
            "type": "enum",
            "options": [
                "Attivo",
                "Inattivo"
            ],
            "default": "Attivo",
            "displayAsLabel": true,
            "labelType": "state",
            "style": {
                "Attivo": "success",
                "Inattivo": "danger"
            }
        }
    },
    "links": {
        "user": {
            "type": "belongsTo",
            "entity": "User"
        },
        "documents": {
            "type": "hasMany",
            "entity": "Document",
            "foreign": "volontariDipendenti"
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "volontariDipendenti"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc",
        "textFilterFields": ["name", "nome", "cognome", "emailAddress"]
    },
    "indexes": {
        "name": {
            "columns": ["name", "deleted"]
        },
        "dataFineStatus": {
            "columns": ["dataFine", "status", "deleted"]
        },
        "user": {
            "type": "unique",
            "columns": ["userId", "deleted"]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true,
    "statusField": "status"
}
