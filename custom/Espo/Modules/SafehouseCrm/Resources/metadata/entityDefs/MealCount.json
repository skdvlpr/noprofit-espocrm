{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true,
            "readOnly": true
        },
        "date": {
            "type": "date",
            "tooltip": "Defaults to today on save when left empty (see formula)."
        },
        "dayOfWeek": {
            "type": "varchar",
            "readOnly": true,
            "storable": true
        },
        "adults": {
            "type": "int",
            "min": 0,
            "default": 0
        },
        "minors": {
            "type": "int",
            "min": 0,
            "default": 0
        },
        "totalMeals": {
            "type": "int",
            "readOnly": true
        },
        "foodUnitPrice": {
            "type": "currency",
            "default": 1.5,
            "currency": "EUR"
        },
        "foodCost": {
            "type": "currency",
            "readOnly": true
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        }
    },
    "collection": {
        "orderBy": "date",
        "order": "desc"
    },
    "indexes": {
        "date": {
            "columns": ["date", "deleted"]
        }
    },
    "optimisticConcurrencyControl": true,
    "audited": true
}
