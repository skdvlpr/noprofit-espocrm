{
    "fields": {
        "duration": {
            "type": "duration",
            "start": "dateStart",
            "end": "dateEnd",
            "options": [900, 1800, 3600, 7200, 10800, 14400, 28800, 86400],
            "default": 3600,
            "notStorable": true,
            "select": {
                "select": "TIMESTAMPDIFF_SECOND:(dateStart, dateEnd)"
            },
            "order": {
                "order": [
                    ["TIMESTAMPDIFF_SECOND:(dateStart, dateEnd)", "{direction}"]
                ]
            }
        }
    }
}
