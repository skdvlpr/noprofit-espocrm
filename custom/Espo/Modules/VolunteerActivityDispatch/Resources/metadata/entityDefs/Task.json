{
    "fields": {
        "dateStart": {
            "type": "datetimeOptional",
            "view": "crm:views/meeting/fields/date-start",
            "before": "dateEnd",
            "default": "javascript: return this.dateTime.getNow(15);",
            "audited": true
        },
        "dateEnd": {
            "type": "datetimeOptional",
            "view": "crm:views/meeting/fields/date-end",
            "after": "dateStart",
            "audited": true
        },
        "duration": {
            "type": "duration",
            "start": "dateStart",
            "end": "dateEnd",
            "options": [900, 1800, 3600, 7200, 10800, 14400, 28800, 86400],
            "default": 3600,
            "notStorable": true,
            "select": {
                "select": "TIMESTAMPDIFF_SECOND:(dateStart, dateEnd)"
            },
            "order": {
                "order": [
                    ["TIMESTAMPDIFF_SECOND:(dateStart, dateEnd)", "{direction}"]
                ]
            }
        },
        "activityOffer": {
            "type": "link",
            "readOnly": true
        },
        "activityOfferSlot": {
            "type": "link",
            "readOnly": true
        },
        "myInviteStatus": {
            "type": "enum",
            "options": ["", "Pending", "Accepted", "Declined"],
            "notStorable": true,
            "readOnly": true,
            "displayAsLabel": true,
            "style": {
                "Pending": "warning",
                "Accepted": "success",
                "Declined": "danger"
            }
        }
    },
    "links": {
        "activityOffer": {
            "type": "belongsTo",
            "entity": "ActivityOffer",
            "foreign": "tasks"
        },
        "activityOfferSlot": {
            "type": "belongsTo",
            "entity": "ActivityOfferSlot",
            "foreign": "task"
        },
        "activityInvites": {
            "type": "hasMany",
            "entity": "ActivityInvite",
            "foreign": "task"
        }
    }
}
