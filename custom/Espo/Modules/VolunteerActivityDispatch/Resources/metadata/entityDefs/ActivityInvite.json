{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true
        },
        "task": {
            "type": "link",
            "required": true
        },
        "user": {
            "type": "link",
            "required": true,
            "view": "views/fields/user"
        },
        "status": {
            "type": "enum",
            "options": ["Pending", "Accepted", "Declined"],
            "default": "Pending",
            "displayAsLabel": true,
            "style": {
                "Pending": "warning",
                "Accepted": "success",
                "Declined": "danger"
            },
            "audited": true
        },
        "respondedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "activityOffer": {
            "type": "link",
            "readOnly": true
        },
        "createdAt": {"type": "datetime", "readOnly": true},
        "modifiedAt": {"type": "datetime", "readOnly": true},
        "createdBy": {"type": "link", "readOnly": true, "view": "views/fields/user"},
        "modifiedBy": {"type": "link", "readOnly": true, "view": "views/fields/user"}
    },
    "links": {
        "task": {
            "type": "belongsTo",
            "entity": "Task",
            "foreign": "activityInvites"
        },
        "user": {
            "type": "belongsTo",
            "entity": "User"
        },
        "activityOffer": {
            "type": "belongsTo",
            "entity": "ActivityOffer"
        },
        "createdBy": {"type": "belongsTo", "entity": "User"},
        "modifiedBy": {"type": "belongsTo", "entity": "User"}
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name"]
    },
    "indexes": {
        "taskUser": {
            "type": "unique",
            "columns": ["taskId", "userId", "deleted"]
        },
        "userStatus": {"columns": ["userId", "status", "deleted"]}
    }
}
