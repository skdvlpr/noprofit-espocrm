{
    "fields": {
        "name": {
            "type": "varchar",
            "trim": true
        },
        "activityOffer": {
            "type": "link",
            "required": true
        },
        "dateStart": {
            "type": "datetime",
            "required": true,
            "view": "crm:views/meeting/fields/date-start"
        },
        "dateEnd": {
            "type": "datetime",
            "required": true,
            "view": "crm:views/meeting/fields/date-end",
            "after": "dateStart"
        },
        "duration": {
            "type": "duration",
            "start": "dateStart",
            "end": "dateEnd",
            "options": [900, 1800, 3600, 7200, 10800, 14400, 28800],
            "default": 3600,
            "notStorable": true
        },
        "category": {
            "type": "enum",
            "options": [
                "MealPreparation",
                "MealDistribution",
                "Administrative",
                "LegalDesk",
                "DigitalDesk",
                "Reception",
                "ListeningDesk",
                "MarketCollection",
                "Cleaning",
                "NightReceptionManagement",
                "ProjectDevelopment",
                "GrantsAndFundingManagement",
                "Fundraising",
                "EventOrganization",
                "Secretariat",
                "ServicesAndSupport",
                "Activities",
                "OnCallAvailability"
            ],
            "required": true,
            "isSorted": true
        },
        "place": {
            "type": "varchar",
            "maxLength": 255
        },
        "task": {
            "type": "link",
            "readOnly": true
        },
        "sortOrder": {
            "type": "int",
            "default": 0
        },
        "createdAt": {"type": "datetime", "readOnly": true},
        "modifiedAt": {"type": "datetime", "readOnly": true},
        "createdBy": {"type": "link", "readOnly": true, "view": "views/fields/user"},
        "modifiedBy": {"type": "link", "readOnly": true, "view": "views/fields/user"}
    },
    "links": {
        "activityOffer": {
            "type": "belongsTo",
            "entity": "ActivityOffer",
            "foreign": "slots"
        },
        "task": {
            "type": "belongsTo",
            "entity": "Task",
            "foreign": "activityOfferSlot"
        },
        "createdBy": {"type": "belongsTo", "entity": "User"},
        "modifiedBy": {"type": "belongsTo", "entity": "User"}
    },
    "collection": {
        "orderBy": "dateStart",
        "order": "asc",
        "textFilterFields": ["name", "place", "category"]
    },
    "indexes": {
        "offerDate": {"columns": ["activityOfferId", "dateStart", "deleted"]}
    }
}
